{
  "name": "jarvis-accountant",
  "version": "0.1.0",
  "description": "JARVIS Accountant Desktop",
  "main": "main.js",
  "author": "Abhishek",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.jarvis.accountant",
    "productName": "JARVIS Accountant",
    "files": ["main.js", "index.html"],
    "win": {
      "target": "portable"
    }
  }
}
